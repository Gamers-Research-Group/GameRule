{
    "GameName": "SURVIVAL_SHOOTER",
    "CameraPosition": [0, 6, -7],
    "CameraRotation": [30, 0.0, 0.0],
    "SunPosition": [3.3899, 10.902, -5.8255],
    "SunRotation": [22.704, 65.875, -175.012],
    "SunColor": [195, 184, 255],
    "SunAmbientColor": [170, 180, 200],
    "CustomVariables": [
        {"name": "Score", "type": "float", "floatValue": 0.0}
    ],
    "Cast": [
        {
            "ActorName": "LightingReflection",
            "PrefabName": "LightingReflection"
        },
        {
            "ActorName": "Environment",
            "PrefabName": "Environment",
            "Tag":"Obstacle"
        },
        {
            "ActorName": "Player",
            "PrefabName": "Player",
            "Tag":"Player",
            "Position": [0.0, 0.0, 0.0],
            "Properties": ["speed=5", "rotSpeed=360", "lastHealth=100.0", "health=100.0", "offsetCam=7", "offsetX=0.28", "offsetY=0.3", "offsetZ=0.7", "moving=0"],
            "Script": [
                {
                    "Do": ["RotateTo(this.rotSpeed,#MouseWorld.x,#MouseWorld.y,#MouseWorld.z,this.x,this.y,this.z)", "Edit(#CameraPosition.x,this.x)", "Edit(#CameraPosition.z,this.z-this.offsetCam)"]
                },
                {
                    "When": ["Keyboard(RightArrow,press)"],
                    "Do": ["Move(this.speed, 0, 90, 0)", "Edit(this.moving,1)"]
                },
                {
                    "When": ["Keyboard(LeftArrow,press)"],
                    "Do": ["Move(this.speed, 0, -90, 0)", "Edit(this.moving,1)"]
                },
                {
                    "When": ["Keyboard(UpArrow,press)"],
                    "Do": ["Move(this.speed, 0, 0, 0)", "Edit(this.moving,1)"]
                },
                {
                    "When": ["Keyboard(DownArrow,press)"],
                    "Do": ["Move(this.speed, 0, 180, 0)", "Edit(this.moving,1)"]
                },
                {   "When": ["Keyboard(RightArrow,up) OR Keyboard(LeftArrow,up) OR Keyboard(UpArrow,up) OR Keyboard(DownArrow,up)"], 
                    "Do": ["Edit(this.moving,0)"] 
                },
                {
                    "When": ["Collision(Hellephant)"],
                    "Do": ["Edit(this.health,this.health-Hellephant.damage)", "PlaySound(PlayerHurt)"]
                },
                {
                    "When": ["Collision(ZomBear)"],
                    "Do": ["Edit(this.health,this.health-ZomBear.damage)", "PlaySound(PlayerHurt)"]
                },
                {
                    "When": ["Collision(ZomBunny)"],
                    "Do": ["Edit(this.health,this.health-ZomBunny.damage)", "PlaySound(PlayerHurt)"]
                },
                {
                    "When":["Compare(this.health<=0)"],
                    "Do":["PlaySound(PlayerDeath)", "Edit(this.moving,0)", "Edit(this.speed,0)"]
                },
                {
                    "When": ["Check(this.moving)"],
                    "Do": ["Animate(Move)"]
                },
                {
                    "When": ["NOT Check(this.moving) AND Compare(this.health>0)"],
                    "Do": ["Animate(Idle)"]
                },
                {
                    "When": ["NOT Check(this.moving) AND Compare(this.health<=0)"],
                    "Do": ["Animate(Death)"]
                }
            ]
        },
        {
            "ActorName": "Hellephant",
            "PrefabName": "Hellephant",
            "Tag":"Hellephant",
            "Active": false,
            "Position": [0.0, 0.0, 32.0],
            "Rotation": [0.0, -130.0, 0.0],
            "Properties": ["speed=2", "health=300", "damage=0.3", "moving=0"],
            "Script": [
                {
                    "Do": ["Edit(this.moving,1)", "NavigateTo(this.speed,Player.x,Player.y,Player.z)"]
                },
                {
                    "When":["Compare(Player.health<0)"],
                    "Do":["Edit(this.moving,0)", "Edit(this.speed,0)"]
                },
                {
                    "When": ["Compare(this.health<=0)"],
                    "Do": ["Edit(#Score,#Score+50)", "Delete(this)"]
                },
                {
                    "When": ["NOT Check(this.moving)"],
                    "Do": ["Animate(Idle)"]
                },
                {
                    "When": ["Check(this.moving)"],
                    "Do": ["Animate(Move)"]
                }
            ]
        },
        {
            "ActorName": "ZomBear",
            "PrefabName": "ZomBear",
            "Tag":"ZomBear",
            "Active": false,
            "Properties": ["speed=3", "health=200", "damage=0.2", "moving=0"],
            "Script": [
                {
                    "Do": ["Edit(this.moving,1)", "NavigateTo(this.speed,Player.x,Player.y,Player.z)"]
                },
                {
                    "When":["Compare(Player.health<0)"],
                    "Do":["Edit(this.moving,0)", "Edit(this.speed,0)"]
                },
                {
                    "When": ["Compare(this.health<=0)"],
                    "Do": ["Edit(#Score,#Score+10)", "Delete(this)"]
                },
                {
                    "When": ["NOT Check(this.moving)"],
                    "Do": ["Animate(Idle)"]
                },
                {
                    "When": ["Check(this.moving)"],
                    "Do": ["Animate(Move)"]
                }
            ]
        },
        {
            "ActorName": "ZomBunny",
            "PrefabName": "ZomBunny",
            "Tag":"ZomBunny",
            "Active": false,
            "Properties": ["speed=4", "health=100", "damage=0.15", "moving=0"],
            "Script": [
                {
                    "Do": ["Edit(this.moving,1)", "NavigateTo(this.speed,Player.x,Player.y,Player.z)"]
                },
                {
                    "When":["Compare(Player.health<0)"],
                    "Do":["Edit(this.moving,0)", "Edit(this.speed,0)"]
                },
                {
                    "When": ["Compare(this.health<=0)"],
                    "Do": ["Edit(#Score,#Score+10)", "Delete(this)"]
                },
                {
                    "When": ["NOT Check(this.moving)"],
                    "Do": ["Animate(Idle)"]
                },
                {
                    "When": ["Check(this.moving)"],
                    "Do": ["Animate(Move)"]
                }
            ]
        },
        {
            "ActorName": "HellephantSpawner",
            "PrefabName": "HellephantSpawner",
            "Position": [0.0, 0.0, 32.0],
            "Rotation": [0.0, -130.0, 0.0],
            "Script": [
                {
                    "When": ["Timer(5)"],
                    "Do": ["Spawn(Hellephant,this)"]
                }
            ]
        },
        {
            "ActorName": "ZomBearSpawner",
            "PrefabName": "ZomBearSpawner",
            "Position": [22.5, 0.0, 15.0],
            "Rotation": [0.0, -120.0, 0.0],
            "Script": [
                {
                    "When": ["Timer(2)"],
                    "Do": ["Spawn(ZomBear,this)"]
                }
            ]
        },
        {
            "ActorName": "ZomBunnySpawner",
            "PrefabName": "ZomBunnySpawner",
            "Position": [-20.5, 0.0, 12.5],
            "Rotation": [0.0, 130.0, 0.0],
            "Script": [
                {
                    "When": ["Timer(3)"],
                    "Do": ["Spawn(ZomBunny,this)"]
                }
            ]
        }
    ]
}